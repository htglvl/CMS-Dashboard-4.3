# CMS Dashboard Environment Variables
# Copy this file to .env and fill in your values

# Electricity North West API Key (required for data fetching and live incidents)
# Register at: https://electricitynorthwest.opendatasoft.com/
ENW_API_KEY=your_api_key_here

# CMS API (required for OpenClaw natural language features)
# Xiaomi MiMo billing token (pay-as-you-go) — replaces the retired monthly XIAOMI_API_KEY.
# BASE_URL/MODEL are synced into ~/.openclaw/openclaw.json by openclaw-plugin/configure.py,
# so change them here (not in openclaw.json) and restart the dashboard.
CMS_API_BASE_URL=https://api.xiaomimimo.com/v1
CMS_API_KEY=your_api_key_here
CMS_API_MODEL=mimo-v2.5

# Alternative LLM providers (optional fallbacks, used only if CMS_API_KEY is not set)
# OPENAI_API_KEY=your_api_key_here
# ANTHROPIC_API_KEY=your_api_key_here

# Cloudflare Workers KV (optional — for permanent tunnel redirect URL)
# Setup: see cloudflare/README.md
CF_API_TOKEN=your_cloudflare_api_token
CF_ACCOUNT_ID=your_cloudflare_account_id
CF_KV_NAMESPACE_ID=your_kv_namespace_id
